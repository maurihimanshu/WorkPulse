# WorkPulse Environment Configuration Template
# Copy this file to .env to configure local settings:
#   cp .env.example .env

# Data storage directory (default: ./data)
WORKPULSE_DATA_DIR=data

# Encryption key file location (default: ./data/activities/key.key)
WORKPULSE_KEY_FILE=data/activities/key.key

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
WORKPULSE_LOG_LEVEL=INFO

# Application logs path (default: ./logs/app.log)
WORKPULSE_LOG_FILE=logs/app.log

# Analytics & Retention (days)
WORKPULSE_DATA_RETENTION_DAYS=30

# Inactivity timeout (seconds before marking idle)
WORKPULSE_INACTIVITY_TIMEOUT=45
